{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cf-open-agents-api",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "worker_loaders": [
    {
      "binding": "CODE_LOADER"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionDO"
      },
      {
        "name": "CATALOG",
        "class_name": "TenantCatalogDO"
      },
      {
        "name": "HARNESS",
        "class_name": "HarnessDO"
      },
      {
        "name": "SANDBOX",
        "class_name": "SandboxDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO", "TenantCatalogDO", "HarnessDO", "SandboxDO"]
    }
  ],
  "containers": [
    {
      "class_name": "HarnessDO",
      "name": "cf-open-agents-api-harness",
      "scheduling_policy": "durable_object",
      "images": {
        "harness": {
          "dockerfile": "../../docker/Harness.Dockerfile",
          "build_context": "../.."
        }
      }
    },
    {
      "class_name": "SandboxDO",
      "name": "cf-open-agents-api-sandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": {
          "dockerfile": "../../docker/Sandbox.Dockerfile",
          "build_context": "../.."
        }
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "CHECKPOINTS",
      "bucket_name": "cf-open-agents-api-checkpoints"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "cf-open-agents-api-workspaces"
    }
  ],
  "services": [
    {
      "binding": "MODEL_GATEWAY",
      "service": "cf-open-agents-api",
      "entrypoint": "Models"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
