{
  "name": "cf-open-agents-api-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionDO"
      },
      {
        "name": "CATALOG",
        "class_name": "CatalogDO"
      },
      {
        "name": "SCRIPTED",
        "class_name": "ScriptedHarness"
      },
      {
        "name": "AI_HARNESS",
        "class_name": "AIHarnessDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO", "CatalogDO", "ScriptedHarness", "AIHarnessDO"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "test-assets"
    },
    {
      "binding": "CHECKPOINTS",
      "bucket_name": "test-checkpoints"
    }
  ]
}
