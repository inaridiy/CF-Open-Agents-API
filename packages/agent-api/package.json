{
  "name": "cf-open-agents-api",
  "version": "0.4.2",
  "description": "Unofficial, independent implementation of the OpenAI Agents API on Cloudflare Workers, Durable Objects and Containers, running Codex, Claude Code or OpenCode against models you configure",
  "homepage": "https://github.com/inaridiy/CF-Open-Agents-API#readme",
  "bugs": {
    "url": "https://github.com/inaridiy/CF-Open-Agents-API/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaridiy/CF-Open-Agents-API.git",
    "directory": "packages/agent-api"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.47",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/sandbox": "0.13.0-next.751.1",
    "fflate": "0.8.3",
    "hono": "^4.13.7",
    "kysely": "^0.29.5",
    "yaml": "2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "ai": "7.0.97",
    "effect": "3.22.2",
    "openai": "7.15.0"
  },
  "peerDependencies": {
    "ai": "^7.0.97",
    "effect": "^3.22.2",
    "openai": "^7.15.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
