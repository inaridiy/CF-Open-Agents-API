{
  "name": "cf-open-agents-api",
  "version": "0.1.0",
  "description": "A Cloudflare-native Agents API with pluggable harnesses and isolated execution",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.47",
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/sandbox": "0.13.0-next.751.1",
    "hono": "4.13.7",
    "kysely": "0.29.5",
    "zod": "4.6.2"
  },
  "peerDependencies": {
    "ai": "^7.0.97",
    "openai": "^7.15.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "ai": "7.0.97",
    "openai": "7.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaridiy/CF-Open-Agents-API.git",
    "directory": "packages/agent-api"
  },
  "homepage": "https://github.com/inaridiy/CF-Open-Agents-API#readme",
  "bugs": {
    "url": "https://github.com/inaridiy/CF-Open-Agents-API/issues"
  }
}
